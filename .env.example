# Kopieren nach .env und Werte anpassen (.env wird NICHT committed)
# Ohne .env wird automatisch SQLite (Datei gymflow.db) verwendet.

# SQLite (Standard, keine Installation nötig):
DATABASE_URL=sqlite:///gymflow.db

# MySQL (später, Benutzer und Datenbank vorher in MySQL anlegen):
# DATABASE_URL=mysql+mysqlconnector://gymflow:passwort@localhost:3306/gymflow
